# Local development secrets for `wrangler dev`. Copy to .dev.vars (gitignored).
# In production set these with `wrangler secret put SESSION_SECRET`.

# Must be at least 16 characters. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me-0123456789
# APP_ORIGIN / cookie Secure are handled automatically for local dev:
# localhost origins are always allowed and the cookie is only marked Secure over HTTPS.
